        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;Vitajte na hlavnej stránke našej klienstkej zóny. Tu nájdeš všetko, čo potrebuješ vedieť a vidieť&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Stav tvojich X-Tokenov&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;X-Token Administrácia&quot;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; =&amp;gt; Možnosť kúpiť X-token balíčky, členstvo alebo mesačnú permanentku&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Rezervácia termínu&quot; &lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;=&amp;gt; jednoduchým spôsobom si rezervuješ termín tréningu&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Odporúčanie&quot;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; =&amp;gt; &lt;/span&gt;&lt;span style=&quot;font-size: 14px; color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;Získaj X-Tokeny zadarmo. Tvoje odporúčanie odmeníme. &lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Správa tvojich odporúčaní  a možnosť poslať odporúčanie známemu.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Moje Platby&quot; =&amp;gt; &lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Zoznam tvojich platieb s detailom&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Moje Rezervácie&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&quot; =&amp;gt; správa tvojich existujúcich rezervácii. Potrebuješ zmeniť rezerváciu alebo si byť len istý, kedy máš tréning&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tlačítko &quot;&lt;/span&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Mám darčekový kupón&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&quot; =&amp;gt; Dostal si darčekový kupón a chceš si uplatniť X-Tokeny&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</text>
